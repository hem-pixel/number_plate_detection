# ==================================================
# Number Plate Recognition - Localhost Environment Configuration
# ==================================================

# Application
PROJECT_NAME="Indian Vehicle Number Plate Recognition"
PORT=8000
HOST="0.0.0.0"

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=number_plate_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/number_plate_db

# AI & Camera Configuration
YOLO_MODEL_PATH="ai-service/models/best.pt"
CAMERA_SOURCE=0
CAMERA_ID="CAM-01"

# Duplicate Control & Stability
EVENT_COOLDOWN_SECONDS=10.0
MIN_CONSECUTIVE_FRAMES=2
YOLO_CONFIDENCE_THRESHOLD=0.45
OCR_CONFIDENCE_THRESHOLD=0.35

# Storage
STORAGE_DIR="storage"
VEHICLES_DIR="storage/vehicles"
PLATES_DIR="storage/plates"

# Frontend & CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
